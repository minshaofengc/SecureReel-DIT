{
  "name": "securereel-dit",
  "productName": "SecureReel DIT",
  "version": "1.2.5",
  "description": "免费开源的摄影机素材拷贝与校验工具：多目标拷贝、xxHash64 复核、ASC MHL、不可变报告。",
  "license": "GPL-3.0-only",
  "author": {
    "name": "Shanfly",
    "email": "minshaofengc@gmail.com"
  },
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build": "electron-vite build",
    "dist:mac": "npm run build && electron-builder --mac",
    "type-check": "npm run type-check:node && npm run type-check:web",
    "type-check:node": "tsc -p tsconfig.node.json --noEmit",
    "type-check:web": "tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:pipeline": "SECUREREEL_VERIFY=1 electron-vite build && electron out/main/verify.js",
    "verify:app": "electron-vite build && SECUREREEL_SMOKE_SCREENSHOT=.verify-output/app.png electron out/main/index.js",
    "verify": "npm run type-check && npm run lint && npm run test && npm run verify:pipeline && npm run verify:app"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^43.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
